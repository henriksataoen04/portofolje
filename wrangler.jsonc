{
  // Ren statisk side — ingen Worker-kode, så "main" er bevisst utelatt.
  // Da er alle forespørsler statiske assets, som er gratis og umålt.
  "name": "portofolje",
  "compatibility_date": "2026-08-28",
  // Byggesteget prerendrer innholdet fra site/ inn i dist/, slik at
  // søkemotorer får ferdig HTML i stedet for en tom div.
  "build": {
    "command": "npm --prefix build ci && node build/prerender.mjs"
  },
  "assets": {
    // dist/ lages av bygget. site/ er kilden og røres ikke.
    "directory": "./dist"
  }
}
